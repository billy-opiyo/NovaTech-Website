{
	"name": "electronics-store",
	"private": true,
	"workspaces": [
		"frontend",
		"backend"
	],
	"scripts": {
		"dev": "npm --workspace frontend run dev",
		"dev:open": "start \"\" http://localhost:3000 && npm --workspace frontend run dev",
		"build": "npm --workspace frontend run build",
		"android:sync": "npx cap sync android",
		"android:open": "npx cap open android",
		"android:debug": "npm run android:sync && cd android && .\\gradlew.bat assembleDebug",
		"android:staging:update": "node scripts/release-android-staging.mjs",
		"android:release:apk": "npm run android:sync && cd android && .\\gradlew.bat copyReleaseApk",
		"android:release:aab": "npm run android:sync && cd android && .\\gradlew.bat bundleRelease",
		"lint": "npm --workspace frontend run lint && npm --workspace backend run build",
		"type-check": "npm --workspace frontend exec tsc -- --noEmit && npm --workspace backend run build",
		"start": "npm --workspace frontend run start",
		"test": "node --test --test-concurrency=1 --require ./tests/register.cjs tests/**/*.test.ts",
		"test:watch": "node --test --test-concurrency=1 --watch --require ./tests/register.cjs tests/**/*.test.ts",
		"db:migrate": "npm --workspace backend run db:migrate",
		"db:deploy": "npm --workspace backend run db:deploy",
		"check:env": "node scripts/check-env.mjs",
		"test:e2e": "playwright test",
		"check:staging": "node scripts/check-staging.mjs",
		"check:backup": "node scripts/verify-backup.mjs",
		"db:push": "npm --workspace backend run db:push",
		"db:seed": "npm --workspace backend run db:seed"
	},
	"dependencies": {
		"@capacitor/app": "^8.1.2",
		"@capacitor/browser": "^8.0.5",
		"@capacitor/core": "^8.5.3",
		"lucide-react": "^1.31.0",
		"react-icons": "^5.7.0",
		"twilio": "^6.0.2"
	},
	"devDependencies": {
		"@capacitor/android": "^8.5.3",
		"@capacitor/cli": "^8.5.3",
		"@playwright/test": "^1.62.1"
	}
}
