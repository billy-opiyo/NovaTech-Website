# Database (Neon PostgreSQL pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
SEED_ADMIN_PASSWORD=""

# Auth.js
AUTH_SECRET="your-secret"
AUTH_GOOGLE_ID="..."
AUTH_GOOGLE_SECRET="..."

# Cloudflare R2
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="..."
NEXT_PUBLIC_R2_PUBLIC_URL="https://cdn.example.com"

# Resend
RESEND_API_KEY="..."

# Twilio SMS
TWILIO_ACCOUNT_SID="..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="..."

# WhatsApp Cloud API
WHATSAPP_TOKEN="..."
WHATSAPP_PHONE_NUMBER_ID="..."

# Next.js public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production platform domain used for tenant subdomains and canonical URLs
PLATFORM_DOMAIN="nuravatech.com"
SHOPPER_COMMERCE_MODEL="MERCHANT_DIRECT"

# M-Pesa Daraja API
MPESA_CONSUMER_KEY="..."
MPESA_CONSUMER_SECRET="..."
MPESA_PASSKEY="..."
MPESA_SHORTCODE="174379"
MPESA_ENV="sandbox" # sandbox | production

# Stripe
STRIPE_SECRET_KEY="..."
STRIPE_WEBHOOK_SECRET="..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="..."
