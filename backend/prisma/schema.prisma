generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- User & Authentication ---
model User {
  id               String        @id @default(cuid())
  name             String?
  email            String        @unique
  emailVerified    DateTime?
  passwordHash     String?
  image            String?
  role             Role          @default(CUSTOMER)
  platformRole     PlatformRole?
  marketingEmails  Boolean       @default(true)
  orderUpdates     Boolean       @default(true)
  preferredTheme   String        @default("dark")
  preferredStoreId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  accounts                     Account[]
  sessions                     Session[]
  orders                       Order[]
  reviews                      Review[]
  wishlistItems                WishlistItem[]
  cartItems                    CartItem[]
  addresses                    Address[]
  supportTickets               SupportTicket[]
  notifications                Notification[]
  adminLogs                    AdminLog[]
  loginEvents                  LoginEvent[]
  memberships                  Membership[]
  billingCustomers             BillingCustomer[]
  billingRecords               BillingRecord[]
  reviewedTenants              Tenant[]                       @relation("TenantVerificationReviewer")
  uploadedVerificationEvidence MerchantVerificationEvidence[] @relation("VerificationEvidenceUploader")
  reviewedVerificationEvidence MerchantVerificationEvidence[] @relation("VerificationEvidenceReviewer")
  preferredStore               Store?                         @relation("UserPreferredStore", fields: [preferredStoreId], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_ANALYST
}

enum MembershipRole {
  STORE_OWNER
  STORE_ADMIN
  STORE_MANAGER
  STORE_SUPPORT
  STORE_EDITOR
}

enum MerchantVerificationStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum MerchantBusinessType {
  INDIVIDUAL
  REGISTERED_BUSINESS
}

enum MerchantTaxStatus {
  REGISTERED
  NOT_REGISTERED
  NOT_APPLICABLE
  UNDER_REVIEW
}

enum MerchantLocationType {
  PHYSICAL_LOCATION
  ONLINE_ONLY
}

enum MerchantSettlementAccountType {
  PAYBILL
  TILL
  OTHER
}

enum MerchantVerificationEvidenceType {
  GOVERNMENT_ID
  BUSINESS_REGISTRATION
  KRA_PIN
  LOCATION_PROOF
  MPESA_OWNERSHIP
  OWNER_DECLARATION
}

enum MerchantVerificationEvidenceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TenantStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  DELETED
}

enum StorePublicationStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum DomainType {
  PLATFORM_SUBDOMAIN
  CUSTOM
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REVOKED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  INCOMPLETE
  UNPAID
}

model Tenant {
  id                      String                     @id @default(cuid())
  legalName               String?
  status                  TenantStatus               @default(TRIALING)
  verificationStatus      MerchantVerificationStatus @default(NOT_STARTED)
  verificationSubmittedAt DateTime?
  verificationReviewedAt  DateTime?
  verificationReviewerId  String?
  verificationNotes       String?
  planId                  String?
  trialStartsAt           DateTime?
  trialEndsAt             DateTime?
  suspendedAt             DateTime?
  deletedAt               DateTime?
  dataRetentionStartsAt   DateTime?
  dataDeletionDueAt       DateTime?
  dataDeletedAt           DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  plan                 Plan?                          @relation(fields: [planId], references: [id])
  verificationReviewer User?                          @relation("TenantVerificationReviewer", fields: [verificationReviewerId], references: [id], onDelete: SetNull)
  verificationProfile  MerchantVerificationProfile?
  verificationEvidence MerchantVerificationEvidence[]
  store                Store?
  memberships          Membership[]
  invitations          Invitation[]
  domains              Domain[]
  subscriptions        Subscription[]
  usageCounters        UsageCounter[]
  featureEntitlements  FeatureEntitlement[]           @relation("TenantEntitlements")
  settingsVersions     StoreSettingsVersion[]
  categories           Category[]
  products             Product[]
  variants             Variant[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  recentlyViewed       RecentlyViewed[]
  orders               Order[]
  payments             Payment[]
  orderItems           OrderItem[]
  addresses            Address[]
  deliveryRegions      DeliveryRegion[]
  reviews              Review[]
  coupons              Coupon[]
  notifications        Notification[]
  supportTickets       SupportTicket[]
  ticketReplies        TicketReply[]
  adminLogs            AdminLog[]
  loginEvents          LoginEvent[]
  billingCustomer      BillingCustomer?
  billingRecord        BillingRecord?
  invoices             Invoice[]
  addonSubscriptions   AddonSubscription[]
  transactions         Transaction[]

  @@index([status, createdAt])
  @@index([verificationStatus])
  @@index([dataDeletionDueAt, dataDeletedAt])
}

model MerchantVerificationProfile {
  id                         String                        @id @default(cuid())
  tenantId                   String                        @unique
  businessType               MerchantBusinessType
  taxStatus                  MerchantTaxStatus
  locationType               MerchantLocationType
  settlementAccountType      MerchantSettlementAccountType
  sensitiveDetailsCiphertext String
  phoneVerifiedAt            DateTime?
  phoneOtpHash               String?
  phoneOtpSalt               String?
  phoneOtpExpiresAt          DateTime?
  phoneOtpAttempts           Int                           @default(0)
  phoneOtpSentAt             DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([phoneVerifiedAt])
}

model MerchantVerificationEvidence {
  id           String                             @id @default(cuid())
  tenantId     String
  type         MerchantVerificationEvidenceType
  status       MerchantVerificationEvidenceStatus @default(PENDING)
  objectKey    String                             @unique
  contentType  String
  sizeBytes    Int
  uploadedById String
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime                           @default(now())
  updatedAt    DateTime                           @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("VerificationEvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy User?  @relation("VerificationEvidenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, type])
}

model Store {
  id                String                 @id @default(cuid())
  tenantId          String                 @unique
  name              String
  slug              String                 @unique
  publicationStatus StorePublicationStatus @default(DRAFT)
  defaultLocale     String                 @default("en-KE")
  currency          String                 @default("KES")
  country           String                 @default("KE")
  timezone          String                 @default("Africa/Nairobi")
  logoUrl           String?
  faviconUrl        String?
  themeSettings     Json?
  seoSettings       Json?
  contactSettings   Json?
  homepageSettings  Json?
  commerceSettings  Json?
  draftSettings     Json?
  publishedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domains          Domain[]
  settingsVersions StoreSettingsVersion[]
  preferredUsers   User[]                 @relation("UserPreferredStore")

  @@index([publicationStatus])
}

model Domain {
  id                 String                   @id @default(cuid())
  tenantId           String
  storeId            String
  hostname           String                   @unique
  type               DomainType
  verificationToken  String                   @unique
  verificationStatus DomainVerificationStatus @default(PENDING)
  sslStatus          String?
  isCanonical        Boolean                  @default(false)
  verifiedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId, verificationStatus])
}

model Membership {
  id          String         @id @default(cuid())
  tenantId    String
  userId      String
  role        MembershipRole
  active      Boolean        @default(true)
  invitedAt   DateTime?
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, active])
}

model Invitation {
  id          String         @id @default(cuid())
  tenantId    String
  email       String
  role        MembershipRole
  tokenHash   String         @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
}

model Plan {
  id                    String           @id @default(cuid())
  key                   String           @unique
  name                  String
  price                 Int?
  currency              String           @default("KES")
  billingInterval       BillingInterval?
  setupFeeAmount        Int              @default(0)
  transactionFeePercent Float            @default(0)
  stripePriceId         String?          @unique
  active                Boolean          @default(true)
  entitlementsJson      Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenants              Tenant[]
  subscriptions        Subscription[]
  pendingSubscriptions Subscription[]       @relation("PendingSubscriptionPlan")
  entitlements         FeatureEntitlement[] @relation("PlanEntitlements")
}

model Subscription {
  id                        String             @id @default(cuid())
  tenantId                  String
  planId                    String
  pendingPlanId             String?
  status                    SubscriptionStatus @default(TRIALING)
  provider                  String?
  providerCustomerId        String?
  providerSubscriptionId    String?
  providerCheckoutSessionId String?
  trialStartsAt             DateTime?
  trialEndsAt               DateTime?
  currentPeriodStart        DateTime?
  currentPeriodEnd          DateTime?
  cancelAtPeriodEnd         Boolean            @default(false)
  gracePeriodEndsAt         DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               Plan                @relation(fields: [planId], references: [id])
  pendingPlan        Plan?               @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  invoices           Invoice[]
  addonSubscriptions AddonSubscription[]
  payments           Payment[]

  @@index([tenantId, status])
  @@index([provider, providerSubscriptionId])
}

model UsageCounter {
  id          String   @id @default(cuid())
  tenantId    String
  metric      String
  periodStart DateTime
  periodEnd   DateTime
  value       Int      @default(0)
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
}

enum BillingRecordStatus {
  PENDING
  PAID
  FAILED
  WAIVED
}

enum InvoiceKind {
  SETUP_FEE
  SUBSCRIPTION
  ADDON
  RENEWAL
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
  FAILED
  CANCELLED
}

enum BillingPaymentKind {
  ORDER
  SETUP_FEE
  SUBSCRIPTION
  ADDON
  RENEWAL
}

enum AddonSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
}

model BillingCustomer {
  id                     String   @id @default(cuid())
  tenantId               String   @unique
  ownerUserId            String?
  stripeCustomerId       String?  @unique
  defaultPaymentMethodId String?
  mpesaPhone             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  User?  @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
}

model BillingRecord {
  id             String              @id @default(cuid())
  tenantId       String              @unique
  ownerUserId    String?
  setupFeeAmount Int                 @default(0)
  currency       String              @default("KES")
  setupFeeStatus BillingRecordStatus @default(PENDING)
  setupFeePaidAt DateTime?
  failureReason  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner    User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  payments Payment[]
}

model Addon {
  id              String          @id @default(cuid())
  key             String          @unique
  name            String
  description     String?
  price           Int
  currency        String          @default("KES")
  billingInterval BillingInterval @default(MONTH)
  stripePriceId   String?         @unique
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  subscriptions AddonSubscription[]
}

model AddonSubscription {
  id                         String                  @id @default(cuid())
  tenantId                   String
  addonId                    String
  subscriptionId             String?
  status                     AddonSubscriptionStatus @default(INCOMPLETE)
  provider                   String?
  providerSubscriptionItemId String?
  currentPeriodStart         DateTime?
  currentPeriodEnd           DateTime?
  cancelAtPeriodEnd          Boolean                 @default(false)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addon        Addon         @relation(fields: [addonId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, addonId])
  @@index([tenantId, status])
}

model Invoice {
  id                String        @id @default(cuid())
  tenantId          String
  subscriptionId    String?
  kind              InvoiceKind   @default(SUBSCRIPTION)
  status            InvoiceStatus @default(DRAFT)
  provider          String?
  providerInvoiceId String?       @unique
  number            String?       @unique
  subtotal          Int
  addonTotal        Int           @default(0)
  setupFeeAmount    Int           @default(0)
  total             Int
  currency          String        @default("KES")
  dueDate           DateTime?
  paidAt            DateTime?
  hostedInvoiceUrl  String?
  invoicePdfUrl     String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, kind])
}

model Transaction {
  id               String   @id @default(cuid())
  tenantId         String
  orderId          String?
  paymentId        String?  @unique
  currency         String   @default("KES")
  grossAmount      Float
  commissionRate   Float    @default(0)
  commissionAmount Float    @default(0)
  status           String   @default("COMPLETED")
  metadata         Json?
  createdAt        DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model FeatureEntitlement {
  id          String    @id @default(cuid())
  featureKey  String
  value       Json
  planId      String?
  tenantId    String?
  effectiveAt DateTime  @default(now())
  expiresAt   DateTime?

  plan   Plan?   @relation("PlanEntitlements", fields: [planId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation("TenantEntitlements", fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([featureKey, effectiveAt])
  @@index([tenantId, featureKey])
}

model StoreSettingsVersion {
  id          String    @id @default(cuid())
  tenantId    String
  storeId     String
  version     Int
  settings    Json
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, version])
}

// --- Products ---
model Category {
  id          String     @id @default(cuid())
  tenantId    String?
  name        String     @unique
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, slug])
}

model Product {
  id              String   @id @default(cuid())
  tenantId        String?
  name            String
  slug            String   @unique
  description     String
  brand           String
  sku             String   @unique
  price           Float
  discountedPrice Float?
  stock           Int      @default(0)
  isFeatured      Boolean  @default(false)
  isNewArrival    Boolean  @default(false)
  warranty        String?
  weight          Float?
  dimensions      String?
  specs           Json? // Flexible specs (CPU, RAM, etc.)
  images          String[] // URLs to R2
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  variants       Variant[]
  reviews        Review[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  recentlyViewed RecentlyViewed[]
  tenant         Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, slug])
  @@index([tenantId, sku])
}

model Variant {
  id            String  @id @default(cuid())
  tenantId      String?
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // e.g., "Color", "Storage", "RAM"
  value         String // e.g., "Red", "256GB", "16GB"
  priceModifier Float?  @default(0)
  stock         Int     @default(0)
  sku           String? @unique
  tenant        Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sku])
}

// --- Cart & Wishlist ---
model CartItem {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  variant   String? // store selected variant (e.g., "Color:Red")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, productId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  viewedAt  DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// --- Orders & Delivery ---
model Order {
  id              String      @id @default(cuid())
  tenantId        String?
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  guestEmail      String?
  status          OrderStatus @default(PENDING)
  subtotal        Float
  shippingCost    Float       @default(0)
  total           Float
  paymentMethod   String?
  shippingAddress Json
  trackingNumber  String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  idempotencyKey  String?

  items        OrderItem[]
  payments     Payment[]
  transactions Transaction[]
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model Payment {
  id                 String             @id @default(cuid())
  tenantId           String?
  orderId            String?
  order              Order?             @relation(fields: [orderId], references: [id])
  provider           String // "mpesa" | "stripe"
  amount             Float
  currency           String             @default("KES")
  status             PaymentStatus      @default(PENDING)
  providerReference  String?            @unique // CheckoutRequestID (M-Pesa) / PaymentIntent ID (Stripe)
  invoiceId          String?
  subscriptionId     String?
  billingRecordId    String?
  kind               BillingPaymentKind @default(ORDER)
  phoneNumber        String?
  customerEmail      String?
  failureCode        String?
  failureReason      String?
  providerCustomerId String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice            Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  subscription       Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingRecord      BillingRecord?     @relation(fields: [billingRecordId], references: [id], onDelete: SetNull)
  transaction        Transaction?

  @@index([orderId])
  @@index([providerReference])
  @@index([tenantId, status])
  @@index([tenantId, kind, createdAt])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(cuid())
  tenantId  String?
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  variant   String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Address {
  id        String  @id @default(cuid())
  tenantId  String?
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String? // e.g., "Home", "Work"
  county    String
  town      String
  landmark  String?
  phone     String
  isDefault Boolean @default(false)
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model DeliveryRegion {
  id       String  @id @default(cuid())
  tenantId String?
  name     String // e.g., "Nairobi"
  cost     Float // KES
  minDays  Int
  maxDays  Int
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, name])
}

// --- Reviews ---
model Review {
  id                 String                 @id @default(cuid())
  tenantId           String?
  userId             String
  user               User                   @relation(fields: [userId], references: [id])
  productId          String
  product            Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating             Int // 1-5
  title              String?
  comment            String?
  photos             String[] // URLs
  isVerifiedPurchase Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  moderationStatus   ReviewModerationStatus @default(PENDING)
  tenant             Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([productId, moderationStatus])
  @@index([tenantId, moderationStatus])
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

// --- Coupons & Notifications ---
model Coupon {
  id              String   @id @default(cuid())
  tenantId        String?
  code            String
  discountPercent Float?
  discountAmount  Float?
  minOrderValue   Float?
  expiresAt       DateTime
  usageLimit      Int?
  usedCount       Int      @default(0)
  isActive        Boolean  @default(true)
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String // e.g., ORDER_STATUS, PROMO
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// --- Support & Admin Logs ---
model SupportTicket {
  id            String         @id @default(cuid())
  tenantId      String?
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  customerName  String
  customerEmail String
  customerPhone String?
  subject       String
  description   String
  category      TicketCategory @default(OTHER)
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus   @default(OPEN)
  orderId       String?
  assignedTo    String?
  attachments   String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  replies TicketReply[]
  tenant  Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

enum TicketCategory {
  TECHNICAL
  BILLING
  SHIPPING
  PRODUCT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

model TicketReply {
  id        String        @id @default(cuid())
  tenantId  String?
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reply     String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
  tenant    Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model AdminLog {
  id        String   @id @default(cuid())
  tenantId  String?
  adminId   String
  admin     User?    @relation(fields: [adminId], references: [id])
  action    String // e.g., "UPDATED_PRODUCT", "DELETED_REVIEW"
  details   Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([tenantId, createdAt])
}

model LoginEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([tenantId, createdAt])
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

model WebhookReceipt {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([receivedAt])
}
