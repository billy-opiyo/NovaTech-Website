<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#061626"
                android:endColor="#0B233A"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#990B1D30" />
            <stroke android:width="1dp" android:color="#33F97316" />
        </shape>
    </item>
</layer-list>
